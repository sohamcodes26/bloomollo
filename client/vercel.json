{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/tools/image-to-pdf/:path*",
      "has": [{ "type": "host", "value": "bloomollo.dpdns.org" }],
      "destination": "https://bloomollo.tech/image-to-pdf/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "bloomollo.dpdns.org" }],
      "destination": "https://bloomollo.tech/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.bloomollo.tech" }],
      "destination": "https://bloomollo.tech/:path*",
      "permanent": true
    },
    {
      "source": "/tools/image-to-pdf",
      "destination": "/image-to-pdf/",
      "permanent": true
    },
    {
      "source": "/tools/image-to-pdf/",
      "destination": "/image-to-pdf/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/theme-init.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/eye-frames/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}