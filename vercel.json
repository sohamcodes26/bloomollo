{
  "$schema": "https://vercel.sh",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://bloomollo.tech*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "data:text/html,<h1>Redirecting...</h1>"
    }
  ]
}
